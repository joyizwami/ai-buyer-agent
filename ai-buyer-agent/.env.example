# AI Buyer Agent - Environment Configuration
# Copy this to .env and fill in your values

# ==================== APPLICATION ====================
APP_NAME="AI Buyer Agent"
APP_VERSION="1.0.0"
DEBUG=false
LOG_LEVEL=INFO

# Server
HOST=0.0.0.0
PORT=8000

# ==================== RAZORPAY (TEST MODE ONLY) ====================
# Get these from Razorpay Dashboard -> Settings -> API Keys
# IMPORTANT: Use TEST MODE keys only (start with rzp_test_)
RAZORPAY_KEY_ID=rzp_test_your_key_id_here
RAZORPAY_KEY_SECRET=your_key_secret_here
RAZORPAY_TEST_MODE=true
RAZORPAY_BASE_URL=https://api.razorpay.com/v1

# ==================== EMAIL RECEIPTS (OPTIONAL) ====================
# Receipts are sent after Razorpay confirms payment.captured.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your-email@gmail.com
SMTP_PASSWORD=your-app-password
SMTP_FROM_EMAIL=your-email@gmail.com
SMTP_USE_TLS=true
RECEIPT_EMAIL=janmayswami@gmail.com

# ==================== LLM CONFIGURATION ====================
# Choose: "openai" or "anthropic"
LLM_PROVIDER=openai

# OpenAI (if using OpenAI)
OPENAI_API_KEY=sk-your-openai-key-here

# Anthropic (if using Anthropic)
ANTHROPIC_API_KEY=sk-ant-your-anthropic-key-here

# LLM Model
LLM_MODEL=gpt-4o-mini
LLM_TEMPERATURE=0.1

# ==================== SPENDING LIMITS (IN INR - will be converted to paise) ====================
# Maximum amount per transaction (INR)
MAX_TRANSACTION_AMOUNT=5000

# Daily spending limit per user (INR)
DAILY_SPENDING_LIMIT=10000

# Amount above which human approval is required (INR)
APPROVAL_THRESHOLD=1000

# ==================== RETRY CONFIGURATION ====================
MAX_RETRIES=3
RETRY_BASE_DELAY=1.0
REQUEST_TIMEOUT=30.0

# ==================== DATABASE ====================
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/ai_buyer_agent

# ==================== PRODUCT CATALOG ====================
CATALOG_PATH=./data/products.json

# ==================== FRONTEND ====================
FRONTEND_ENABLED=true